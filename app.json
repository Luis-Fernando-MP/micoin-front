{
  "expo": {
    "name": "MiCoin",
    "slug": "micoin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "micoin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/logo-lg.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MiCoin to access your camera.",
          "microphonePermission": "Allow MiCoin to access your microphone.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MiCoin to use your location."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MiCoin to access your contacts."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow MiCoin to access your calendar."
        }
      ],
      "expo-mail-composer",
      "expo-localization",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MiCoin to save receipts to your photos.",
          "savePhotosPermission": "Allow MiCoin to save receipts to your photos."
        }
      ],
      "expo-sqlite",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.micoin",
          "enableGooglePay": false
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
