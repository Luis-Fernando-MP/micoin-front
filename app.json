{
  "expo": {
    "name": "MiCoin",
    "slug": "micoin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "micoin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.micoin.app"
    },
    "android": {
      "package": "com.micoin.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/logo-lg.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "MiCoin usa Face ID para desbloquear tu cuenta."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MiCoin usa Face ID para desbloquear tu cuenta."
        }
      ],
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MiCoin to access your camera.",
          "microphonePermission": "Allow MiCoin to access your microphone.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MiCoin to use your location."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MiCoin to access your contacts."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow MiCoin to access your calendar."
        }
      ],
      "expo-mail-composer",
      "expo-localization",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MiCoin to save receipts to your photos.",
          "savePhotosPermission": "Allow MiCoin to save receipts to your photos."
        }
      ],
      "expo-sqlite",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.micoin",
          "enableGooglePay": false
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "5d0db4aa-a312-4d6c-a9c0-386bc891308e"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "juju-fer"
  }
}
